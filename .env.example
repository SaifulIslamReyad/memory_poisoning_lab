# Groq-compatible model API key
GROQ_API_KEY=your_groq_api_key_here

# Required for hosted deployments
APP_PASSWORD=your_app_password_here

# Required hosted PostgreSQL/Supabase connection string
DATABASE_URL=postgresql://postgres:your_database_password@db.example.supabase.co:5432/postgres?sslmode=require

GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_REQUEST_TIMEOUT=30
LAB_MAX_ROWS=100
LAB_MAX_RESULT_BYTES=1048576
LAB_MAX_QUERY_STEPS=100000
